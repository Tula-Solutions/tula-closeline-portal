{
  "name": "tula-closeline-portal",
  "version": "0.0.0",
  "description": "Closeline portal: the dashboard web app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare": "husky || true",
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "build:verify": "VITE_ENVIRONMENT=local bunx --bun vite build --outDir out/verify",
    "check": "biome check src scripts test vite.config.ts",
    "bundle:check": "bun scripts/check-bundle.ts out/verify",
    "routes:generate": "tsr generate",
    "generate:api": "bun scripts/generate-api.ts",
    "test:scripts": "bun test scripts",
    "vendor:public": "bun scripts/vendor-public-openapi.ts",
    "spec:check": "bun scripts/generate-api.ts --check --siblings",
    "generate:check": "bun scripts/generate-api.ts --check && tsr generate && git diff --exit-code -- src/routeTree.gen.ts",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "shared:check": "bash .claude/hooks/shared-check.sh",
    "verify": "bun run check && bun run typecheck && bun run test:coverage && bun run test:scripts && bun run generate:check && bun run build:verify && bun run bundle:check && bun run shared:check",
    "verify:changed": "biome check --changed --no-errors-on-unmatched src scripts test vite.config.ts && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^20.14.6",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "bun-types": "^1.4.3",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@sentry/browser": "^11.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tula-closeline-contract": "git+ssh://git@github.com/Tula-Solutions/tula-closeline-contract.git#v0.44.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  }
}
