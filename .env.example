# Copy to .env.local for development (never commit it). Vite embeds every VITE_* value in the
# built files, so nothing here may be a secret. The schema is src/env.ts; a bad value stops the
# app at boot with a message naming the variable.

# local | dev | staging | prod. Behaviour is gated on this, never on Vite's mode.
VITE_ENVIRONMENT=local

# Dev server only (no VITE_ prefix, so never in the bundle): where the dev server proxies the
# paths in src/api/service-routes.ts. The browser only ever calls this server's own origin.
# Each is an http(s) origin with no path. These are the defaults.
AUTH_PROXY_TARGET=http://127.0.0.1:3001
CORE_PROXY_TARGET=http://127.0.0.1:3002
PLAYBOOK_PROXY_TARGET=http://127.0.0.1:3003

# Dev server only: extra Host headers the dev server accepts, for example a tunnel. A comma-separated
# list of exact hostnames (no port). Unset keeps Vite's default. `true`, `*` and
# wildcard or suffix entries are refused: they would turn the Host check off.
PORTAL_DEV_ALLOWED_HOSTS=

# Required unless VITE_ENVIRONMENT=local. Leave empty to turn error reporting off.
VITE_SENTRY_DSN=

# The build's version, set by CI (a git SHA or tag); sent with error reports.
VITE_RELEASE=

# Local only: the host of the fake Google issuer the auth service runs by default, so "Continue with
# Google" may send the browser there. Refused outside VITE_ENVIRONMENT=local. Example: 127.0.0.1:3015
VITE_GOOGLE_FAKE_ISSUER_HOST=
